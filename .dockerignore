# Allow-list: only what the server needs goes into the build. Everything else stays out, including
# secrets (.env), corpora, model weights and private recordings (data/, eval/), and the local virtualenv.
*
!requirements.txt
!backend
!content
# The one part of data/ that goes in: generated reference audio (Azure clips + their timings), nothing private.
!data/tts_cache
**/__pycache__
**/*.pyc
**/.DS_Store
